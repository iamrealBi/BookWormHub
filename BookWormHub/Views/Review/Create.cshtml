@model BookWormHub.ViewModels.ReviewCreateViewModel
@{ ViewData["Title"] = "Viết Review"; }
<h1>Viết Review cho "@Model.BookTitle"</h1>
<div class="row"><div class="col-md-6"><form asp-action="Create" method="post"><input type="hidden" name="BookId" value="@Model.BookId" /><div class="mb-3"><label class="form-label">Rating (1-5 sao)</label><select name="Rating" class="form-select" required><option value="">-- Chọn --</option><option value="5">★★★★★ (5)</option><option value="4">★★★★ (4)</option><option value="3">★★★ (3)</option><option value="2">★★ (2)</option><option value="1">★ (1)</option></select></div><div class="mb-3"><label class="form-label">Bình luận (tùy chọn)</label><textarea name="Comment" class="form-control" rows="4" placeholder="Chia sẻ cảm nhận..."></textarea></div><button type="submit" class="btn btn-primary">Gửi Review</button> <a asp-controller="Book" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-secondary">Hủy</a></form></div></div>
