@model BookWormHub.ViewModels.ReviewEditViewModel
@{ ViewData["Title"] = "Sửa Review"; }
<h1>Sửa Review cho "@Model.BookTitle"</h1>
<div class="row"><div class="col-md-6"><form asp-action="Edit" method="post"><input type="hidden" name="BookId" value="@Model.BookId" /><div class="mb-3"><label class="form-label">Rating (1-5 sao)</label><select name="Rating" class="form-select" required><option value="5" selected="@(Model.Rating == 5)">★★★★★ (5)</option><option value="4" selected="@(Model.Rating == 4)">★★★★ (4)</option><option value="3" selected="@(Model.Rating == 3)">★★★ (3)</option><option value="2" selected="@(Model.Rating == 2)">★★ (2)</option><option value="1" selected="@(Model.Rating == 1)">★ (1)</option></select></div><div class="mb-3"><label class="form-label">Bình luận</label><textarea name="Comment" class="form-control" rows="4">@Model.Comment</textarea></div><button type="submit" class="btn btn-primary">Cập Nhật</button> <a asp-controller="Book" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-secondary">Hủy</a></form></div></div>
