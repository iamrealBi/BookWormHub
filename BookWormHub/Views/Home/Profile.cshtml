@model BookWormHub.ViewModels.ProfileViewModel
@using BookWormHub.Models
@{ ViewData["Title"] = "Hồ Sơ Của Tôi"; var approvedCount = Model.Reviews.Count(r => r.Status == ReviewStatus.Approved); var remaining = 10 - approvedCount; }
<h1>Hồ Sơ Của Tôi</h1>
<div class="card mb-4"><div class="card-body"><dl class="row"><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.User.Email</dd><dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@if (Model.User.IsCritic){<span class="badge bg-primary">Critic</span><small class="text-muted ms-2">Từ @(Model.User.CrticSince?.ToString("dd/MM/yyyy") ?? "")</small>}else{<span class="badge bg-secondary">Thành viên</span>@if (remaining > 0){<small class="text-muted ms-2">(Còn @remaining reviews nữa để thành Critic)</small>}}</dd><dt class="col-sm-3">Tổng reviews</dt><dd class="col-sm-9">@Model.Reviews.Count</dd></dl></div></div>
<h3>Reviews Của Tôi</h3>
@if (Model.Reviews.Count == 0){<p class="text-muted">Bạn chưa viết review nào.</p>}else{<table class="table table-striped"><thead><tr><th>Sách</th><th>Rating</th><th>Trạng Thái</th><th>Ngày</th></tr></thead><tbody>@foreach (var r in Model.Reviews){<tr><td><a asp-controller="Book" asp-action="Details" asp-route-id="@r.BookId">@r.Book?.Title</a></td><td>@for (int i = 0; i < r.Rating; i++) { <text>★</text> }</td><td>@if (r.Status == ReviewStatus.Approved){<span class="badge bg-success">Approved</span>}else if (r.Status == ReviewStatus.Hidden){<span class="badge bg-warning">Chờ duyệt</span>}else{<span class="badge bg-danger">Rejected</span>}</td><td>@r.CreatedAt.ToString("dd/MM/yyyy")</td></tr>}</tbody></table>}
