@model BookWormHub.ViewModels.AdminReviewsViewModel
@{ ViewData["Title"] = "Duyệt Reviews"; }
<h1>Reviews Chờ Duyệt</h1>
@if (!string.IsNullOrEmpty(Model.StatusMessage)) { <div class="alert alert-success alert-dismissible fade show" role="alert">@Model.StatusMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
@if (Model.Reviews.Count == 0){<div class="alert alert-info">Không có review nào chờ duyệt.</div>}else{<p class="text-muted">Có <strong>@Model.Reviews.Count</strong> reviews chờ duyệt</p>@foreach (var review in Model.Reviews){<div class="card mb-3 border-warning"><div class="card-header bg-warning text-dark"><strong>@review.User?.UserName</strong> reviewed <em>@review.Book?.Title</em> — @review.Rating ★ <small class="float-end">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></div><div class="card-body"><p>@(review.Comment ?? "(Không có bình luận)")</p><form method="post" style="display:inline"><button asp-action="ApproveReview" asp-route-id="@review.Id" class="btn btn-success btn-sm">Duyệt</button> <button asp-action="RejectReview" asp-route-id="@review.Id" class="btn btn-danger btn-sm">Từ Chối</button></form></div></div>}}
