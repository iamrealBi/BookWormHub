@model BookWormHub.ViewModels.BookDetailsViewModel
@{ ViewData["Title"] = Model.Book.Title; }
<h1>@Model.Book.Title</h1>
@if (!string.IsNullOrEmpty(Model.StatusMessage)){<div class="alert alert-success alert-dismissible fade show" role="alert">@Model.StatusMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>}
<div class="mb-3">@if (Model.AvgRating != null){<span class="fs-4 text-warning">@for (int i = 1; i <= 5; i++){@(i <= Math.Round(Model.AvgRating.Value) ? "★" : "☆")}</span><span class="fs-5 ms-2">@Model.AvgRating.Value.ToString("F1") / 5.0</span><span class="text-muted ms-2">(@Model.ReviewCount @(Model.ReviewCount == 1 ? "review" : "reviews"))</span>}else{<span class="text-muted fs-5">Not yet rated</span>}</div>
<div class="card mb-4"><div class="card-body"><dl class="row"><dt class="col-sm-3">Tác Giả</dt><dd class="col-sm-9">@Model.Book.Author</dd><dt class="col-sm-3">ISBN-13</dt><dd class="col-sm-9"><code>@Model.Book.ISBN13</code></dd><dt class="col-sm-3">Thể Loại</dt><dd class="col-sm-9">@Model.Book.Genre</dd><dt class="col-sm-3">Năm Xuất Bản</dt><dd class="col-sm-9">@(Model.Book.PublishedYear?.ToString() ?? "Không rõ")</dd><dt class="col-sm-3">Mô Tả</dt><dd class="col-sm-9">@(Model.Book.Description ?? "Chưa có mô tả")</dd></dl></div></div>
<div class="mb-3">@if (User.Identity?.IsAuthenticated == true){@if (Model.MyReview != null){<a asp-controller="Review" asp-action="Edit" asp-route-id="@Model.MyReview.Id" class="btn btn-warning">Sửa Review Của Tôi</a>}else{<a asp-controller="Review" asp-action="Create" asp-route-id="@Model.Book.Id" class="btn btn-primary">Viết Review</a>}}else{<a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary">Đăng nhập để viết review</a>} <a asp-action="Index" class="btn btn-secondary">Quay lại</a></div>
@{var sorted = Model.Book.Reviews.OrderByDescending(r => r.User?.IsCritic == true).ThenByDescending(r => r.CreatedAt).ToList();}
<h3>Reviews (@sorted.Count)</h3>
@if (sorted.Count == 0){<p class="text-muted">Chưa có review nào cho cuốn sách này.</p>}else{@foreach (var review in sorted){<div class="card mb-2 @(review.User?.IsCritic == true ? "border-primary" : "")"><div class="card-body"><div class="d-flex justify-content-between"><div><strong>@review.User?.UserName</strong>@if (review.User?.IsCritic == true){<span class="badge bg-primary ms-1">Critic</span>}<span class="text-warning ms-2">@for (int i = 0; i < review.Rating; i++) { <text>★</text> }</span></div><small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy")</small></div>@if (!string.IsNullOrEmpty(review.Comment)){<p class="mt-2 mb-0">@review.Comment</p>}</div></div>}}
