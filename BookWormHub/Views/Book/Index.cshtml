@model BookWormHub.ViewModels.BookIndexViewModel
@{ ViewData["Title"] = "Thư Viện Sách"; }
<h1>Thư Viện Sách</h1>
<div class="card mb-3"><div class="card-body"><form method="get" asp-action="Index" class="row g-2 align-items-end"><div class="col-md-5"><label class="form-label">Tìm kiếm</label><input type="text" name="search" class="form-control" value="@Model.CurrentSearch" placeholder="Nhập tên sách hoặc tác giả..." /></div><div class="col-md-3"><label class="form-label">Thể loại</label><select name="genre" class="form-select"><option value="">-- Tất cả --</option>@foreach (var g in Model.Genres){<option value="@g" selected="@(Model.CurrentGenre == g)">@g</option>}</select></div><div class="col-md-4"><button type="submit" class="btn btn-primary">Tìm</button> <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>@if (User.IsInRole("Admin")){<a asp-action="Create" class="btn btn-success">Thêm Sách</a>}</div></form></div></div>
@if (!string.IsNullOrWhiteSpace(Model.CurrentSearch)){<p class="text-muted">Tìm thấy <strong>@Model.Books.Count</strong> kết quả cho "<em>@Model.CurrentSearch</em>"</p>}
@if (Model.Books.Count == 0){<div class="alert alert-info">Không tìm thấy sách nào.</div>}else{<table class="table table-striped"><thead><tr><th>Tên Sách</th><th>Tác Giả</th><th>Rating</th><th>Thể Loại</th>@if (User.IsInRole("Admin")) { <th>Hành Động</th> }</tr></thead><tbody>@foreach (var book in Model.Books){<tr><td><a asp-action="Details" asp-route-id="@book.Id">@book.Title</a></td><td>@book.Author</td><td>@if (book.Reviews.Any()){var avg = book.Reviews.Average(r => r.Rating);<span class="text-warning">★</span> @avg.ToString("F1") <small class="text-muted">(@book.Reviews.Count)</small>}else{<span class="text-muted">—</span>}</td><td>@book.Genre</td>@if (User.IsInRole("Admin")){<td><a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-warning">Sửa</a> <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">Xóa</a></td>}</tr>}</tbody></table>}
