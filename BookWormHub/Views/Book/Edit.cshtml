@model BookWormHub.ViewModels.BookEditViewModel
@{ ViewData["Title"] = "Sửa: " + Model.Title; }
<h1>Sửa Sách</h1>
<div class="row"><div class="col-md-6"><form asp-action="Edit" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="Id" /><div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div><div class="mb-3"><label asp-for="Author" class="form-label"></label><input asp-for="Author" class="form-control" /><span asp-validation-for="Author" class="text-danger"></span></div><div class="mb-3"><label asp-for="ISBN13" class="form-label"></label><input asp-for="ISBN13" class="form-control" /><span asp-validation-for="ISBN13" class="text-danger"></span></div><div class="mb-3"><label asp-for="Genre" class="form-label"></label><select asp-for="Genre" class="form-select"><option value="">-- Chọn --</option><option>Programming</option><option>Fiction</option><option>Science</option><option>History</option><option>Business</option><option>Other</option></select></div><div class="mb-3"><label asp-for="PublishedYear" class="form-label"></label><input asp-for="PublishedYear" class="form-control" type="number" /></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><button type="submit" class="btn btn-primary">Lưu</button> <a asp-action="Index" class="btn btn-secondary">Hủy</a></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
